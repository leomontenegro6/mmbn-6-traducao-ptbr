@archive 80FDA0
@size 7

script 1 mmbn6 {
	mugshotShow
		mugshot = Shuko
	msgOpen
	"""
	Ativar a União Cruzada
	permite a você usar o
	poder de um Navi ligado.
	"""
	keyWait
		any = false
	clearMsg
	"""
	É só ativar uma vez
	que você fica ligado
	a batalha inteira.
	"""
	keyWait
		any = false
	clearMsg
	"""
	Vou explicar como se
	Cruza: na Seleção de
	Chips na TelaCust,
	"""
	keyWait
		any = false
	clearMsg
	"""
	aperte para cima
	no direcional.
	"""
	keyWait
		any = false
	clearMsg
	"""
	Isso vai te levar pra
	Tela de Seleção Cruzada.
	É só selecionar.
	"""
	keyWait
		any = false
	clearMsg
	"""
	Vá em frente,
	experimente!
	"""
	keyWait
		any = false
	end
}
script 2 mmbn6 {
	mugshotShow
		mugshot = Shuko
	msgOpen
	"""
	Certo. É assim que se
	ativa a União Cruzada.
	Agora, à luta.
	"""
	keyWait
		any = false
	clearMsg
	"""
	Com o AquaCruz,
	o tiro carregado
	dispara um BubbleShot
	"""
	keyWait
		any = false
	clearMsg
	"""
	que atinge o inimigo
	e se expande.
	"""
	keyWait
		any = false
	clearMsg
	"""
	E segurar o botão ao
	usar um chip de Água
	que não "para o tempo"
	"""
	keyWait
		any = false
	clearMsg
	"""
	dobra o ataque dele.
	"""
	keyWait
		any = false
	clearMsg
	"""
	E, como bônus, usar um
	chip de Água também
	restaura alguns PV.
	"""
	keyWait
		any = false
	end
}
script 3 mmbn6 {
	mugshotShow
		mugshot = Shuko
	msgOpen
	"""
	E aí, sente
	que já dominou?
	"""
	keyWait
		any = false
	clearMsg
	"""
	Ativar uma União
	Cruzada lhe dará
	o poder do Navi,
	"""
	keyWait
		any = false
	clearMsg
	"""
	mas, em troca, você
	vai precisar prestar
	atenção em certas coisas.
	"""
	keyWait
		any = false
	clearMsg
	"""
	Além do dano dobrado
	que você receberá do
	elemento contra o qual
	"""
	keyWait
		any = false
	clearMsg
	"""
	você é fraco, também
	vai perder sua ligação
	com o Navi Cruzado.
	"""
	keyWait
		any = false
	clearMsg
	"""
	O AquaCruz, no caso,
	é fraco contra ataques
	Elétricos.
	"""
	keyWait
		any = false
	clearMsg
	"""
	Sempre que for usar uma
	União Cruzada, fique de
	olho na fraqueza dela.
	"""
	keyWait
		any = false
	end
}
