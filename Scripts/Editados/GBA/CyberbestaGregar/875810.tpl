@archive 875810
@size 50

script 0 mmbn6 {
	mugshotShow
		mugshot = Boy
	msgOpen
	"""
	É possível tirar
	um chip raro no
	Troca-Chips,
	"""
	keyWait
		any = false
	clearMsg
	"""
	mas também é possível
	tirar um chip besta...
	"""
	keyWait
		any = false
	clearMsg
	"""
	E trocar 3 chips
	por 1 só é um belo
	de um sacrifício.
	"""
	keyWait
		any = false
	clearMsg
	"""
	Lembrando que, quando
	se usa o Troca-Chips,
	o jogo é salvo
	"""
	keyWait
		any = false
	clearMsg
	"""
	automaticamente,
	então, cuidado.
	"""
	keyWait
		any = false
	clearMsg
	"""
	E nunca, JAMAIS
	insira um chip
	raro por acidente!
	"""
	keyWait
		any = false
	clearMsg
	"""
	Ahhh! Só de pensar,
	já deu um arrepio!!
	"""
	keyWait
		any = false
	end
}
