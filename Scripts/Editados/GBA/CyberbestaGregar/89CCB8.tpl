@size 2

script 0 mmbn6 {
	msgOpen
	"""
	São os dados vestigiais
	de um Navi...
	"""
	keyWait
		any = false
	clearMsg
	"""
	Não param de repetir
	as mesmas coisas sem
	parar...
	"""
	keyWait
		any = false
	clearMsg
	mugshotShow
		mugshot = HeelNaviBlack
	"""
	L... B... B...
	R... B... A... A...
	... LRR...
	"""
	keyWait
		any = false
	end
}
